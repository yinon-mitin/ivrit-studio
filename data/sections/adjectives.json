  "items": [
    {"id": "adjectives.yeled-gadol", "he": "יֶלֶד גָּדוֹל", "translit": "Yeled gadol", "en": "a big boy", "ru": "большой мальчик", "group": "agreement", "related": [{"he": "יַלְדָּה גְּדוֹלָה", "translit": "Yalda gdola", "en": "a big girl", "ru": "большая девочка"}, {"he": "יְלָדִים גְּדוֹלִים", "translit": "Yeladim gdolim", "en": "big boys, big children", "ru": "большие мальчики, большие дети"}, {"he": "יְלָדוֹת גְּדוֹלוֹת", "translit": "Yeladot gdolot", "en": "big girls", "ru": "большие девочки"}], "note": {"en": "Every adjective has four forms (m., f., m. pl., f. pl.) and agrees with its noun in gender and number. Gadol and katan are in Sizes: their first a becomes a short e in the other forms (gadol → gdola) because the stress moves forward.", "ru": "У каждого прилагательного четыре формы (м., ж., м. мн., ж. мн.), и оно согласуется с существительным в роде и числе. Gadol и katan — в разделе «Размеры»: первое «а» в других формах становится кратким «е» (gadol → gdola), потому что ударение сдвигается вперёд."}, "verified": false},
    {"id": "adjectives.milim-khadashot", "he": "מִלִּים חֲדָשׁוֹת", "translit": "Milim khadashot", "en": "new words", "ru": "новые слова", "group": "agreement", "note": {"en": "Milim ends in the “masculine” -im, but milla is feminine, and the adjective shows it: khadashot, not khadashim. The adjective is always regular, so it is a reliable clue to the noun’s gender. Learn each new noun together with an adjective.", "ru": "Milim оканчивается на «мужское» -im, но milla — женского рода, и прилагательное это показывает: khadashot, а не khadashim. Прилагательное всегда правильное, поэтому по нему легко узнать род. Учите каждое новое существительное вместе с прилагательным."}, "verified": false},
    {"id": "adjectives.shulkhanot-ktanim", "he": "שֻׁלְחָנוֹת קְטַנִּים", "translit": "Shulkhanot ktanim", "en": "small tables", "ru": "маленькие столы", "group": "agreement", "note": {"en": "The opposite case: shulkhanot ends in the “feminine” -ot, but shulkhan is masculine, so the adjective is ktanim, not ktanot.", "ru": "Обратный случай: shulkhanot оканчивается на «женское» -ot, но shulkhan — мужского рода, поэтому прилагательное ktanim, а не ktanot."}, "verified": false},
    {"id": "adjectives.tov", "he": "טוֹב", "translit": "Tov", "en": "good (m.)", "ru": "хороший (м.)", "group": "forms", "forms": {"ms": "טוֹב", "fs": "טוֹבָה", "mp": "טוֹבִים", "fp": "טוֹבוֹת"}, "related": [{"he": "טוֹבָה", "translit": "Tova", "en": "good (f.)", "ru": "хорошая (ж.)"}, {"he": "טוֹבִים", "translit": "Tovim", "en": "good (m. pl.)", "ru": "хорошие (м. мн.)"}, {"he": "טוֹבוֹת", "translit": "Tovot", "en": "good (f. pl.)", "ru": "хорошие (ж. мн.)"}], "verified": false},
    {"id": "adjectives.khadash", "he": "חָדָשׁ", "translit": "Khadash", "en": "new (m.)", "ru": "новый (м.)", "group": "forms", "forms": {"ms": "חָדָשׁ", "fs": "חֲדָשָׁה", "mp": "חֲדָשִׁים", "fp": "חֲדָשׁוֹת"}, "related": [{"he": "חֲדָשָׁה", "translit": "Khadasha", "en": "new (f.)", "ru": "новая (ж.)"}, {"he": "חֲדָשִׁים", "translit": "Khadashim", "en": "new (m. pl.)", "ru": "новые (м. мн.)"}, {"he": "חֲדָשׁוֹת", "translit": "Khadashot", "en": "new (f. pl.)", "ru": "новые (ж. мн.)"}], "note": {"en": "Khadash means both “new” and “modern”.", "ru": "Khadash значит и «новый», и «современный»."}, "verified": false},
    {"id": "adjectives.yafe", "he": "יָפֶה", "translit": "Yafe", "en": "beautiful, nice (m.)", "ru": "красивый (м.)", "group": "forms", "forms": {"ms": "יָפֶה", "fs": "יָפָה", "mp": "יָפִים", "fp": "יָפוֹת"}, "related": [{"he": "יָפָה", "translit": "Yafa", "en": "beautiful, nice (f.)", "ru": "красивая (ж.)"}, {"he": "יָפִים", "translit": "Yafim", "en": "beautiful, nice (m. pl.)", "ru": "красивые (м. мн.)"}, {"he": "יָפוֹת", "translit": "Yafot", "en": "beautiful, nice (f. pl.)", "ru": "красивые (ж. мн.)"}], "note": {"en": "Without nikud the m. and f. forms look the same, יפה: yafe or yafa? Only the context tells.", "ru": "Без огласовок формы м. и ж. выглядят одинаково, יפה: yafe или yafa? Подскажет только контекст."}, "verified": false},
    {"id": "adjectives.yashan", "he": "יָשָׁן", "translit": "Yashan", "en": "old (things) (m.)", "ru": "старый (о вещах) (м.)", "group": "forms", "forms": {"ms": "יָשָׁן", "fs": "יְשָׁנָה", "mp": "יְשָׁנִים", "fp": "יְשָׁנוֹת"}, "related": [{"he": "יְשָׁנָה", "translit": "Yeshana", "en": "old (things) (f.)", "ru": "старая (о вещах) (ж.)"}, {"he": "יְשָׁנִים", "translit": "Yeshanim", "en": "old (things) (m. pl.)", "ru": "старые (о вещах) (м. мн.)"}, {"he": "יְשָׁנוֹת", "translit": "Yeshanot", "en": "old (things) (f. pl.)", "ru": "старые (о вещах) (ж. мн.)"}], "note": {"en": "Only for things: bayit yashan, mekhonit yeshana. For people and animals use zaken.", "ru": "Только для вещей: bayit yashan, mekhonit yeshana. Для людей и животных — zaken."}, "verified": false},
    {"id": "adjectives.zaken", "he": "זָקֵן", "translit": "Zaken", "en": "old (people, animals) (m.)", "ru": "старый (о людях, животных) (м.)", "group": "forms", "forms": {"ms": "זָקֵן", "fs": "זְקֵנָה", "mp": "זְקֵנִים", "fp": "זְקֵנוֹת"}, "related": [{"he": "זְקֵנָה", "translit": "Zkena", "en": "old (people, animals) (f.)", "ru": "старая (о людях, животных) (ж.)"}, {"he": "זְקֵנִים", "translit": "Zkenim", "en": "old (people, animals) (m. pl.)", "ru": "старые (о людях, животных) (м. мн.)"}, {"he": "זְקֵנוֹת", "translit": "Zkenot", "en": "old (people, animals) (f. pl.)", "ru": "старые (о людях, животных) (ж. мн.)"}], "note": {"en": "For old people, dogs and other animals; not for things (see yashan).", "ru": "О пожилых людях, собаках и других животных; не о вещах (см. yashan)."}, "verified": false},
    {"id": "adjectives.bayit-yashan", "he": "בַּיִת יָשָׁן", "translit": "Bayit yashan", "en": "an old house", "ru": "старый дом", "group": "pairs", "related": [{"he": "מְכוֹנִית יְשָׁנָה", "translit": "Mekhonit yeshana", "en": "an old car", "ru": "старая машина"}], "verified": false},
    {"id": "adjectives.kelev-zaken", "he": "כֶּלֶב זָקֵן", "translit": "Kelev zaken", "en": "an old dog", "ru": "старая собака (пёс)", "group": "pairs", "related": [{"he": "אִשָּׁה זְקֵנָה", "translit": "Isha zkena", "en": "an old woman", "ru": "пожилая женщина"}], "verified": false},
    {"id": "adjectives.yalda-yafa", "he": "יַלְדָּה יָפָה", "translit": "Yalda yafa", "en": "a pretty girl", "ru": "красивая девочка", "group": "pairs", "verified": false},
