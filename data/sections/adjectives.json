    {"id": "adjectives.eretz-gdola", "he": "אֶרֶץ גְּדוֹלָה", "translit": "Eretz gdola", "en": "a big country", "ru": "большая страна", "group": "pairs", "note": {"en": "Eretz (country) and ir (city) are always feminine.", "ru": "Eretz (страна) и ir (город) всегда женского рода."}, "verified": false},
