    {"id": "infinitives.latet", "he": "לָתֵת", "translit": "Latet", "en": "to give", "ru": "давать", "group": "irregular", "verified": false},
    {"id": "infinitives.lishtot", "he": "לִשְׁתּוֹת", "translit": "Lishtot", "en": "to drink", "ru": "пить", "group": "irregular", "verified": false},
    {"id": "infinitives.rotze-le-ekhol", "he": "אֲנִי רוֹצֶה לֶאֱכֹל", "plain": "אני רוצה לאכול", "translit": "Ani rotze le'ekhol", "en": "I want to eat. (m.)", "ru": "Я хочу есть. (м.)", "group": "frames", "note": {"en": "After want, love, need and can the second verb stays an infinitive; only the first one changes (rotze / rotza).", "ru": "После «хочу», «люблю», «нужно» и «могу» второй глагол остаётся инфинитивом; меняется только первый (rotze / rotza)."}, "verified": false},
