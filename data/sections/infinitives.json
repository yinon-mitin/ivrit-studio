  "items": [
    {"id": "infinitives.likhtov", "he": "לִכְתֹּב", "plain": "לכתוב", "translit": "Likhtov", "en": "to write", "ru": "писать", "group": "pattern", "note": {"en": "Infinitive = le- + the root letters. Compare kotev: k-t-v → li-khtov. The same letters, a little different vowels.", "ru": "Инфинитив = le- + буквы корня. Сравните kotev: к-т-в → li-khtov. Те же буквы, гласные немного другие."}, "verified": false},
    {"id": "infinitives.likro", "he": "לִקְרֹא", "plain": "לקרוא", "translit": "Likro", "en": "to read", "ru": "читать", "group": "pattern", "verified": false},
    {"id": "infinitives.ledaber", "he": "לְדַבֵּר", "translit": "Ledaber", "en": "to speak", "ru": "говорить", "group": "pattern", "verified": false},
    {"id": "infinitives.lilmod", "he": "לִלְמֹד", "plain": "ללמוד", "translit": "Lilmod", "en": "to study, to learn", "ru": "учиться, изучать", "group": "pattern", "verified": false},
    {"id": "infinitives.la-avod", "he": "לַעֲבֹד", "plain": "לעבוד", "translit": "La'avod", "en": "to work", "ru": "работать", "group": "pattern", "verified": false},
    {"id": "infinitives.lagur", "he": "לָגוּר", "translit": "Lagur", "en": "to live (somewhere)", "ru": "жить (где-то)", "group": "pattern", "verified": false},
    {"id": "infinitives.le-ekhol", "he": "לֶאֱכֹל", "plain": "לאכול", "translit": "Le'ekhol", "en": "to eat", "ru": "есть (кушать)", "group": "irregular", "note": {"en": "The first root letter א, ה, ח or ע changes the vowel after le-: le'ekhol, la'avod.", "ru": "Если первая буква корня א, ה, ח или ע, меняется гласная после le-: le'ekhol, la'avod."}, "verified": false},
    {"id": "infinitives.lalekhet", "he": "לָלֶכֶת", "translit": "Lalekhet", "en": "to go, to walk", "ru": "идти, ходить", "group": "irregular", "note": {"en": "The root h-l-kh loses its first letter: halakh → la-lekhet.", "ru": "Корень h-l-kh теряет первую букву: halakh → la-lekhet."}, "verified": false},
    {"id": "infinitives.lavo", "he": "לָבוֹא", "translit": "Lavo", "en": "to come", "ru": "приходить", "group": "irregular", "verified": false},
